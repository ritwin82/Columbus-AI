APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

OLLAMA_BASE_URL=http://localhost:11434
PLANNER_MODEL=gemma3:12b
TASK_MODEL=gemma3:4b
FALLBACK_CHAT_MODEL=qwen2.5-coder:3b
EMBEDDING_MODEL=bge-m3
FALLBACK_EMBEDDING_MODEL=all-minilm
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ENABLE_LOCAL_RERANKER=false
RAG_MODE=local
RAG_CHUNKS_PATH=data/chunks/chunks.jsonl
RAG_COLLECTION=travel_knowledge
RAG_INDEX_NAME=travel-knowledge
RAG_EXTERNAL_TIMEOUT_SECONDS=2

POSTGRES_URL=postgresql+psycopg://travelmind:travelmind@localhost:5432/travelmind
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
OPENSEARCH_URL=http://localhost:9200
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=
ENABLE_LOCAL_MODELS=false
USE_MOCK_PROVIDERS=true
PERSISTENCE_BACKEND=memory
MAX_REFLECTIONS=3
REQUEST_TIMEOUT_SECONDS=20
