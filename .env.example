APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

OLLAMA_BASE_URL=http://localhost:11434
PLANNER_MODEL=gemma3:12b
TASK_MODEL=gemma3:4b
FALLBACK_CHAT_MODEL=qwen2.5-coder:3b
EMBEDDING_MODEL=bge-m3
FALLBACK_EMBEDDING_MODEL=all-minilm
MODEL_PROVIDER_ORDER=openrouter,google,ollama
GOOGLE_AI_API_KEY=
GOOGLE_PLANNER_MODEL=gemma-4-26b-a4b-it
GOOGLE_TASK_MODEL=gemma-4-26b-a4b-it
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PLANNER_MODEL=google/gemma-3-12b-it
OPENROUTER_TASK_MODEL=google/gemma-3-4b-it
OPENROUTER_EMBEDDING_MODEL=baai/bge-m3
OPENROUTER_APP_NAME=TravelMind AI
OPENROUTER_SITE_URL=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ENABLE_LOCAL_RERANKER=false
RAG_MODE=local
RAG_CHUNKS_PATH=data/chunks/chunks.jsonl
RAG_COLLECTION=travel_knowledge
RAG_INDEX_NAME=travel-knowledge
